#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <iomanip>

using namespace std;

// --- Student Class ---
class Student {
public:
    string id;
    string name;
    bool isPresent;

    Student(string _id, string _name) : id(_id), name(_name), isPresent(false) {}
};

// --- Attendance Manager Class ---
class AttendanceManager {
private:
    vector<Student> students;
    const string fileName = "students.txt";
    const string recordFile = "attendance_records.txt";

public:
    // Load student list from a text file
    void loadStudents() {
        ifstream file(fileName);
        if (!file.is_open()) {
            cout << "Error: Could not open " << fileName << ". Please create it first.\n";
            return;
        }

        string id, name;
        while (file >> id >> ws && getline(file, name)) {
            students.push_back(Student(id, name));
        }
        file.close();
    }

    // Take attendance via console
    void takeAttendance() {
        if (students.empty()) {
            cout << "No students loaded. Check students.txt\n";
            return;
        }

        cout << "\n--- Mark Attendance (y for Present, n for Absent) ---\n";
        for (auto &s : students) {
            char choice;
            cout << s.id << " - " << s.name << ": ";
            cin >> choice;
            s.isPresent = (choice == 'y' || choice == 'Y');
        }
        saveRecords();
    }

    // Save attendance to a text file
    void saveRecords() {
        ofstream file(recordFile, ios::app); // Open in append mode
        if (!file.is_open()) return;

        file << "\n--- Attendance Session ---\n";
        for (const auto &s : students) {
            file << s.id << " | " << s.name << " | " 
                 << (s.isPresent ? "Present" : "Absent") << endl;
        }
        file.close();
        cout << "Attendance saved successfully to " << recordFile << endl;
    }

    // Display current list
    void displayStudents() {
        cout << "\n" << left << setw(10) << "ID" << setw(20) << "Name" << endl;
        cout << "------------------------------\n";
        for (const auto &s : students) {
            cout << left << setw(10) << s.id << setw(20) << s.name << endl;
        }
    }
};

// --- Main Menu Interface ---
int main() {
    AttendanceManager manager;
    manager.loadStudents();

    int choice;
    do {
        cout << "\n--- Digital Attendance System ---\n";
        cout << "1. View Student List\n";
        cout << "2. Take Attendance\n";
        cout << "3. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1: manager.displayStudents(); break;
            case 2: manager.takeAttendance(); break;
            case 3: cout << "Exiting system...\n"; break;
            default: cout << "Invalid choice!\n";
        }
    } while (choice != 3);

    return 0;
}
