#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <iomanip>
#include <algorithm>

using namespace std;

// --- Data Structures ---

struct Student {
    string indexNumber;
    string name;

    void save(ofstream &out) const {
        out << indexNumber << "," << name << endl;
    }
};

struct AttendanceRecord {
    string studentIndex;
    string status; // Present, Absent, Late
};

class AttendanceSession {
public:
    string courseCode;
    string date;
    string startTime;
    int duration;
    vector<AttendanceRecord> records;

    void displaySummary() {
        int p = 0, a = 0, l = 0;
        for (const auto& r : records) {
            if (r.status == "Present") p++;
            else if (r.status == "Absent") a++;
            else if (r.status == "Late") l++;
        }
        cout << "\n--- Summary for " << courseCode << " ---" << endl;
        cout << "Present: " << p << " | Absent: " << a << " | Late: " << l << endl;
    }
};

// --- System Manager ---

class AttendanceSystem {
private:
    vector<Student> students;
    vector<AttendanceSession> sessions;
    const string studentFile = "students.txt";
    const string sessionFile = "sessions.txt";

public:
    AttendanceSystem() {
        loadData();
    }

    // 5.1 Student Management
    void registerStudent() {
        Student s;
        cout << "Enter Index Number: "; cin >> s.indexNumber;
        cin.ignore();
        cout << "Enter Name: "; getline(cin, s.name);
        students.push_back(s);
        saveData();
        cout << "Student registered successfully!\n";
    }

    void viewStudents() {
        cout << "\n--- Registered Students ---\n";
        for (const auto& s : students) {
            cout << "ID: " << s.indexNumber << " | Name: " << s.name << endl;
        }
    }

    void searchStudent() {
        string id;
        cout << "Enter Index Number to search: "; cin >> id;
        for (const auto& s : students) {
            if (s.indexNumber == id) {
                cout << "Found: " << s.name << endl;
                return;
            }
        }
        cout << "Student not found.\n";
    }

    // 5.2 Attendance Session Management
    void createSession() {
        AttendanceSession sess;
        cout << "Course Code: "; cin >> sess.courseCode;
        cout << "Date (DD/MM/YYYY): "; cin >> sess.date;
        cout << "Start Time: "; cin >> sess.startTime;
        cout << "Duration (mins): "; cin >> sess.duration;

        for (const auto& s : students) {
            AttendanceRecord rec;
            rec.studentIndex = s.indexNumber;
            cout << "Mark status for " << s.name << " (P/A/L): ";
            char stat; cin >> stat;
            if (stat == 'P' || stat == 'p') rec.status = "Present";
            else if (stat == 'L' || stat == 'l') rec.status = "Late";
            else rec.status = "Absent";
            sess.records.push_back(rec);
        }
        sessions.push_back(sess);
        saveData();
    }

    // 5.4 File Storage (Persistence)
    void saveData() {
        ofstream sOut(studentFile);
        for (const auto& s : students) sOut << s.indexNumber << "|" << s.name << endl;
        sOut.close();

        ofstream sessOut(sessionFile);
        for (const auto& sess : sessions) {
            sessOut << sess.courseCode << "|" << sess.date << "|" << sess.startTime << "|" << sess.duration << endl;
            for (const auto& r : sess.records) {
                sessOut << "R|" << r.studentIndex << "|" << r.status << endl;
            }
        }
        sessOut.close();
    }

    void loadData() {
        // Simple loading logic (abbreviated for brevity)
        ifstream sIn(studentFile);
        string line;
        while (getline(sIn, line)) {
            // Parsing logic here...
        }
    }

    void runMenu() {
        int choice;
        do {
            cout << "\n--- ATTENDANCE SYSTEM ---\n";
            cout << "1. Register Student\n2. View All Students\n3. Search Student\n";
            cout << "4. Create Session (Mark Attendance)\n5. Exit\nChoice: ";
            cin >> choice;

            switch (choice) {
                case 1: registerStudent(); break;
                case 2: viewStudents(); break;
                case 3: searchStudent(); break;
                case 4: createSession(); break;
            }
        } while (choice != 5);
    }
};

int main() {
    AttendanceSystem system;
    system.runMenu();
    return 0;
}
